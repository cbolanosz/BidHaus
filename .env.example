# Template for .env, which Git ignores. Setup is documented in the README.
# A real environment variable takes precedence over anything set here.

# --- Mail -------------------------------------------------------------------
# Required: BidHaus sends its notifications over SMTP (FR09, FR10, FR11).
# Gmail expects an app password here, not the account password.
BIDHAUS_EMAIL_HOST_USER=
BIDHAUS_EMAIL_HOST_PASSWORD=abcdefghijklmnop

# Falls back to BIDHAUS_EMAIL_HOST_USER. Gmail rewrites any other sender.
BIDHAUS_DEFAULT_FROM_EMAIL=

# Base of every link a notification carries, so it must be absolute.
BIDHAUS_SITE_URL=http://127.0.0.1:8000

# Gmail is the default provider; override for another one.
# BIDHAUS_EMAIL_HOST=smtp.gmail.com
# BIDHAUS_EMAIL_PORT=587
# BIDHAUS_EMAIL_USE_TLS=true
# BIDHAUS_EMAIL_TIMEOUT=10

# Prints the messages to the terminal instead of sending them.
# BIDHAUS_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Django -----------------------------------------------------------------
# DEBUG is off unless this file turns it on, so a server deployed without reading
# the documentation never exposes a traceback. On a developer machine it has to be
# on: with it off, runserver stops handing out the stylesheet and the page loads
# with no styles at all.
BIDHAUS_DEBUG=true

# SECRET_KEY is mandatory in production, where DEBUG must stay off.
# BIDHAUS_SECRET_KEY=
# BIDHAUS_ALLOWED_HOSTS=bidhaus.example.com

# --- Money ------------------------------------------------------------------
# Percentage BidHaus keeps when it releases the funds of a sale.
# BIDHAUS_COMMISSION_PERCENTAGE=5

# --- Optional ---------------------------------------------------------------
# BIDHAUS_DATABASE_PATH=db.sqlite3
# BIDHAUS_TIME_ZONE=America/Bogota
# BIDHAUS_CURRENCY=COP
# BIDHAUS_IDENTITY_DOCUMENT_ROOT=private-media

# Lets runserver hand out media/. Only needed to see the custom error pages with
# DEBUG off while the photographs still load. Never on a real server.
# BIDHAUS_SERVE_MEDIA_LOCALLY=true
